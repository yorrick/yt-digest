[Unit]
Description=Fetch YouTube captions, summarize with DeepSeek, and post digest
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/work/yt-digest
ExecStartPre=/usr/bin/git pull --ff-only
ExecStart=%h/work/yt-digest/scripts/run-digest.sh
TimeoutStartSec=3600

[Install]
WantedBy=default.target
